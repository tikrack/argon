    testing.Reset()
    test_flags()
    test_option_forms()
    test_defaults()
    test_types()
    test_positionals()
    test_required()
    test_unknown()
    test_invalid_values()
    test_help()
    test_subcommands()
    test_empty_input()
    test_duplicates()
    test_spaces_and_empty()
    test_short_groups()
    test_validation()
    test_negatable_and_bool()
    test_count_flag()
    test_multiple_parsers()
    test_extras_and_completion()
    test_error_format()
    test_definition_errors()
    test_accessors()
    test_hidden_items()
    ret testing.Summary()
end
