// lang: en
package argon

import os

include model "argon/model.salam"
include parse "argon/parse.salam"
include help "argon/help.salam"
include complete "argon/complete.salam"

pub const ArgKindFlag := 0
pub const ArgKindStr := 1
pub const ArgKindInt := 2
pub const ArgKindFloat := 3
pub const ArgKindBool := 4
pub const ArgKindCount := 5

pub const ArgColorAuto := 0
pub const ArgColorAlways := 1
pub const ArgColorNever := 2

pub const ArgExitOK := 0
pub const ArgExitUsage := 2

pub type OptionSpec = model.OptionSpec
pub type ArgumentSpec = model.ArgumentSpec
pub type Command = model.Command
pub type Value = model.Value
pub type Result = model.Result

pub struct Parser:
    pub program: model.Program = model.Program {}
    pub func SetVersion(version: str): this.program.SetVersion(version) end
    pub func DisableHelpFlag(): this.program.DisableHelpFlag() end
    pub func SetColor(mode: int): this.program.SetColor(mode) end
    pub func AllowExtras(): this.program.AllowExtras() end
    pub func Flag(name: str, short: str, help: str):
        this.program.Flag(name, short, help)
    end
    pub func NegatableFlag(name: str, short: str, help: str, default_on: bool):
        this.program.NegatableFlag(name, short, help, default_on)
    end
    pub func CountFlag(name: str, short: str, help: str):
        this.program.CountFlag(name, short, help)
    end
    pub func StrOption(name: str, short: str, help: str, default_value: str):
        this.program.StrOption(name, short, help, default_value)
    end
    pub func IntOption(name: str, short: str, help: str, default_value: i64):
        this.program.IntOption(name, short, help, default_value)
    end
    pub func FloatOption(name: str, short: str, help: str, default_value: f64):
        this.program.FloatOption(name, short, help, default_value)
    end
    pub func BoolOption(name: str, short: str, help: str, default_value: bool):
        this.program.BoolOption(name, short, help, default_value)
    end
    pub func MultiOption(name: str, short: str, help: str):
        this.program.MultiOption(name, short, help)
    end
    pub func AddOption(spec: OptionSpec): this.program.AddOption(spec) end
    pub func AddArgument(spec: ArgumentSpec): this.program.AddArgument(spec) end
    pub func Positional(name: str, help: str):
        this.program.Positional(name, help)
    end
    pub func OptionalPositional(name: str, help: str):
        this.program.OptionalPositional(name, help)
    end
    pub func RestPositional(name: str, help: str, min_count: int):
        this.program.RestPositional(name, help, min_count)
    end
    pub func AddCommand(cmd: Command): this.program.AddCommand(cmd) end
    pub func Parse(args: Vector<str>): Result:
        ret parse.All(this.program, args)
    end
    pub func ParseProcess(): Result:
        raw := os.Args()
        mut args := Vector {} as Vector<str>
        mut i := 1
        until i < raw.len():
            args.push(raw.get(i))
            i += 1
        end
        ret parse.All(this.program, args)
    end
    pub func Help(): str:
        ret help.Render(this.program, "", help.WantColor(this.program))
    end
    pub func HelpFor(name: str): str:
        ret help.Render(this.program, name, help.WantColor(this.program))
    end
    pub func Usage(): str: ret help.RenderUsage(this.program, "") end
    pub func UsageFor(name: str): str:
        if model.FindCommand(this.program, name) < 0: ret "" end
        ret help.RenderUsage(this.program, name)
    end
    pub func VersionLine(): str:
        if this.program.version == "": ret this.program.prog end
        ret this.program.prog + " " + this.program.version
    end
    pub func CommandCount(): int: ret this.program.commands.len() end
    pub func CommandName(index: int): str:
        if index < 0 or index >= this.program.commands.len(): ret "" end
        ret this.program.commands.get(index).name
    end
    pub func CommandHelp(index: int): str:
        if index < 0 or index >= this.program.commands.len(): ret "" end
        ret this.program.commands.get(index).help
    end
    pub func Completion(shell: str): str:
        ret complete.Script(this.program, shell)
    end
    pub func Free(): this.program.Free() end
end

pub func New(program: str, description: str): Parser:
    ret Parser { program = model.NewProgram(program, description) }
end

pub func NewCommand(name: str, help: str): Command:
    ret model.NewCommand(name, help)
end

pub func NewOption(name: str, short: str, help: str, kind: int): OptionSpec:
    ret model.NewOption(name, short, help, kind)
end

pub func NewFlag(name: str, short: str, help: str): OptionSpec:
    ret model.NewFlag(name, short, help)
end

pub func NewNegatableFlag(name: str, short: str, help: str, default_on: bool): OptionSpec:
    ret model.NewNegatableFlag(name, short, help, default_on)
end

pub func NewCountFlag(name: str, short: str, help: str): OptionSpec:
    ret model.NewCountFlag(name, short, help)
end

pub func NewStrOption(name: str, short: str, help: str, default_value: str): OptionSpec:
    ret model.NewStrOption(name, short, help, default_value)
end

pub func NewIntOption(name: str, short: str, help: str, default_value: i64): OptionSpec:
    ret model.NewIntOption(name, short, help, default_value)
end

pub func NewFloatOption(name: str, short: str, help: str, default_value: f64): OptionSpec:
    ret model.NewFloatOption(name, short, help, default_value)
end

pub func NewBoolOption(name: str, short: str, help: str, default_value: bool): OptionSpec:
    ret model.NewBoolOption(name, short, help, default_value)
end

pub func NewMultiOption(name: str, short: str, help: str): OptionSpec:
    ret model.NewMultiOption(name, short, help)
end

pub func NewArgument(name: str, help: str): ArgumentSpec:
    ret model.NewArgument(name, help)
end

pub func NewOptionalArgument(name: str, help: str): ArgumentSpec:
    ret model.NewOptionalArgument(name, help)
end

pub func NewRestArgument(name: str, help: str, min_count: int): ArgumentSpec:
    ret model.NewRestArgument(name, help, min_count)
end
